# https://github.com/caddyserver/caddy-docker
# purely static site: caddy serves the prerendered files rsynced to ./dist
{
	email alex.barbalex@gmail.com
	#acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
	#debug
}

(static) {
	encode gzip
	# the site is frozen documentation; the last documented year is 2024
	redir / /events/2024/ 308
	redir /events /events/2024/ 308
	redir /events/ /events/2024/ 308
	root * /srv
	file_server
	handle_errors {
		rewrite * /404.html
		file_server
	}
}

